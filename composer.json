{
    "name": "mstaack/laravel-postgis",
    "description": "Fork of mstaack/laravel-postgis with Laravel 11 support. Bosnadev dependency removed and inlined.",
    "require": {
        "php": ">=8.1",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "geo-io/wkb-parser": "^1.0",
        "jmikola/geojson": "^1.0"
    },
    "require-dev": {
        "illuminate/pagination": "^10.0|^11.0|^12.0",
        "phpunit/phpunit": ">=9.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "MStaack\\LaravelPostgis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MStaack\\LaravelPostgis\\Tests\\": "tests/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Peter Haza",
            "email": "peter.haza@gmail.com"
        },
        {
            "name": "Max Matteo Staack",
            "email": "maxmatteostaack@gmail.com"
        },
        {
            "name": "Paperboy Logistics",
            "email": "kacper@paperboylogistics.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "MStaack\\LaravelPostgis\\DatabaseServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit"
    }
}